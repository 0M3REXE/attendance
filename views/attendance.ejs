<!DOCTYPE html>
<html><head><meta charset="utf-8"><title>Mark Attendance</title>
<style>
body{font-family:Arial,sans-serif;background:#f4f6f9;margin:0;}
.nav{background:#2563eb;color:#fff;padding:12px 20px;}
.nav a{color:#fff;text-decoration:none;margin-left:15px;}
.container{max-width:800px;margin:20px auto;padding:0 20px;}
.card{background:#fff;padding:20px;border-radius:8px;box-shadow:0 1px 4px rgba(0,0,0,.1);}
table{width:100%;border-collapse:collapse;}
th,td{padding:8px 10px;text-align:left;border-bottom:1px solid #eee;}
select{padding:6px;}
button{padding:10px 20px;background:#2563eb;color:#fff;border:none;border-radius:4px;cursor:pointer;margin-top:10px;}
</style></head>
<body>
<div class="nav"><span>Mark Attendance</span><a href="/dashboard">Back</a></div>
<div class="container"><div class="card">
<form method="GET" action="/attendance" style="margin-bottom:15px;">
  <label>Date: </label><input type="date" name="date" value="<%= date %>">
  <button type="submit">Load</button>
</form>
<form method="POST" action="/attendance">
  <input type="hidden" name="date" value="<%= date %>">
  <table>
  <tr><th>Roll No</th><th>Name</th><th>Status</th></tr>
  <% students.forEach(s=>{ %>
  <tr>
    <td><%= s.roll_no %></td><td><%= s.name %></td>
    <td>
      <select name="status_<%= s.id %>">
        <option value="present" <%= map[s.id]==='present'?'selected':'' %>>Present</option>
        <option value="absent" <%= map[s.id]==='absent'?'selected':'' %>>Absent</option>
      </select>
    </td>
  </tr>
  <% }) %>
  </table>
  <button type="submit">Save Attendance</button>
</form>
</div></div>
</body></html>
